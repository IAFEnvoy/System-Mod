{
  "chapter.5A71080000000000.title": "08 · 系统手册",
  "quest.5A71080001000000.title": "如何使用任务图钉",
  "quest.5A71080001000000.quest_desc": [
    "任务列表每个格子右上角都有图钉。点击后图钉会转为竖直，表示已固定；再点一次取消。",
    "任务详情也有相同图钉。固定只保留在当前客户端连接中，不会推进任务进度。"
  ],
  "quest.5A71080002000000.title": "物品检测与主动提交",
  "quest.5A71080002000000.quest_desc": [
    "检测类目标只要求背包持有指定物品，不会消耗。",
    "提交类目标需要明确操作，可能消耗物品。打开可提交任务列表，查看要求后再确认。",
    "标为仅任务界面提交的目标必须回到 FTB 原生界面。"
  ],
  "quest.5A71080003000000.title": "章节与分页",
  "quest.5A71080003000000.quest_desc": [
    "左侧只显示当前查询结果涉及的章节，点击章节会切换右侧内容。",
    "每页按列数和三行区域自动分页，内容不足也保留区域和分页栏。翻页不会确认或关闭通知。"
  ],
  "quest.5A71080004000000.title": "支线解锁后的隐藏说明",
  "quest.5A71080004000000.quest_desc": [
    "十二条支线来自同一个前置任务。完成“开启十二条支线”之后，这篇说明才应进入该玩家可查询的结果。"
  ]
}
