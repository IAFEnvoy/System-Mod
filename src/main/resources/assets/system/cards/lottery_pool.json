{
  "body": [
    {
      "type": "system:flex",
      "style": "lottery_heading",
      "text_separator": " · ",
      "children": [
        {
          "type": "system:title",
          "level": 2,
          "text": "{{label}}",
          "style": "lottery_name"
        },
        {
          "type": "system:text",
          "translate": "system.ui.lottery_count",
          "args": [
            "{{prize_count}}"
          ],
          "inline": true,
          "style": "lottery_count"
        }
      ],
      "direction": "row",
      "wrap": true
    },
    {
      "type": "system:text",
      "text": "{{id}}",
      "when": "full",
      "style": [
        "lottery_id",
        "card_context"
      ]
    },
    {
      "type": "system:text",
      "text": "{{field:price}}: {{price_text}}",
      "when": "priced"
    },
    {
      "type": "system:text",
      "translate": "system.ui.lottery_unavailable",
      "unless": "payment_available",
      "style": [
        "lottery_unavailable",
        "card_context"
      ]
    },
    {
      "type": "system:container",
      "unless": "text_items",
      "when": "prizes",
      "children": [
        {
          "type": "system:text",
          "translate": "system.ui.lottery_prize_preview",
          "args": [
            "{{preview_count}}",
            "{{prize_count}}"
          ],
          "style": [
            "item_group_label",
            "card_context"
          ]
        },
        {
          "type": "system:grid",
          "source": "{{prizes}}",
          "children": [
            {
              "type": "system:flex",
              "source": "{{prizes.*.preview_items}}",
              "style": "offer_cell_items",
              "children": [
                {
                  "type": "system:item",
                  "item": "{{prizes.*.preview_items.*}}",
                  "size": 36,
                  "tooltip": [
                    {
                      "type": "system:text",
                      "translate": "system.ui.lottery_chance",
                      "args": [
                        "{{prizes.*.chance}}%"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "system:text",
              "text": "{{prizes.*.reward_label}}",
              "style": "offer_cell_label"
            }
          ],
          "columns": 6,
          "max_row": 3,
          "cell": 104
        },
        {
          "type": "system:text",
          "translate": "system.ui.lottery_hint",
          "style": [
            "lottery_hint",
            "card_context"
          ]
        }
      ]
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.visible}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ],
  "style": [
    "result_card",
    "lottery_card"
  ],
  "show_title": false,
  "hide_summary": true
}
