{
  "body": [
    {
      "type": "system:title",
      "translate": "system.ui.nav_anchor"
    },
    {
      "type": "system:text",
      "text": "{{capacity}}",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{cooldown}}",
      "when": "cooling",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{feedback}}",
      "when": "feedback"
    },
    {
      "type": "system:container",
      "when": "quote",
      "children": [
        {
          "type": "system:text",
          "text": "{{quote_label}}",
          "style": "card_title_2"
        },
        {
          "type": "system:text",
          "translate": "system.anchor.confirm_cost",
          "style": "card_context"
        },
        {
          "type": "system:text",
          "text": "{{price_text}}",
          "style": "card_context"
        }
      ]
    },
    {
      "type": "system:text",
      "translate": "system.anchor.empty",
      "unless": "anchors"
    },
    {
      "type": "system:grid",
      "source": "{{anchors}}",
      "columns": 2,
      "compact_columns": 1,
      "max_row": 3,
      "cell": 160,
      "children": [
        {
          "type": "system:flex",
          "direction": "column",
          "style": "card_column",
          "children": [
            {
              "type": "system:text",
              "text": "{{anchors.*.name}}",
              "style": "offer_cell_label"
            },
            {
              "type": "system:text",
              "text": "{{anchors.*.dimension}}",
              "style": "card_context"
            },
            {
              "type": "system:text",
              "text": "{{anchors.*.position}}",
              "style": "card_context"
            },
            {
              "type": "system:text",
              "translate": "system.anchor.locked",
              "when": "anchors.*.locked",
              "style": "card_context"
            },
            {
              "type": "system:flex",
              "style": "card_actions",
              "children": [
                {
                  "type": "system:button",
                  "click": "return-val",
                  "value": "{{anchors.*.teleport_value}}",
                  "disabled": "{{anchors.*.locked}}",
                  "behavior": "replace",
                  "children": [
                    {
                      "type": "system:text",
                      "translate": "system.action.anchor_teleport"
                    }
                  ]
                },
                {
                  "type": "system:button",
                  "click": "local",
                  "value": "{{anchors.*.rename_binding}}",
                  "children": [
                    {
                      "type": "system:text",
                      "translate": "system.action.anchor_rename"
                    }
                  ]
                },
                {
                  "type": "system:button",
                  "click": "return-val",
                  "value": "{{anchors.*.delete_value}}",
                  "behavior": "replace",
                  "children": [
                    {
                      "type": "system:text",
                      "translate": "system.action.anchor_delete"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "system:container",
      "when": "destinations",
      "children": [
        {
          "type": "system:title",
          "level": 2,
          "translate": "system.anchor.public_destination"
        },
        {
          "type": "system:grid",
          "source": "{{destinations}}",
          "columns": 2,
          "compact_columns": 1,
          "max_row": 3,
          "cell": 160,
          "children": [
            {
              "type": "system:button",
              "click": "return-val",
              "value": "{{destinations.*.teleport_value}}",
              "disabled": "{{destinations.*.locked}}",
              "behavior": "replace",
              "style": "offer_cell_content",
              "label": "{{destinations.*.label}}",
              "children": [
                {
                  "type": "system:text",
                  "text": "{{destinations.*.label}}",
                  "style": "offer_cell_label"
                },
                {
                  "type": "system:text",
                  "text": "{{destinations.*.description}}",
                  "style": "card_context"
                },
                {
                  "type": "system:text",
                  "text": "{{destinations.*.dimension}}",
                  "style": "card_context"
                },
                {
                  "type": "system:text",
                  "translate": "system.ui.condition_unmet",
                  "when": "destinations.*.locked",
                  "style": "card_context"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.footer}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "when": "actions.*.visible",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
