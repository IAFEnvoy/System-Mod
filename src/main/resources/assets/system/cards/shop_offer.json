{
  "body": [
    {
      "type": "system:title",
      "text": "{{label}}"
    },
    {
      "type": "system:text",
      "text": "{{summary}}",
      "when": "confirm"
    },
    {
      "type": "system:text",
      "text": "{{items}}",
      "when": "text_items"
    },
    {
      "type": "system:flex",
      "source": "{{offer_items}}",
      "children": [
        {
          "type": "system:item",
          "item": "{{offer_items.*}}",
          "size": 40,
          "tooltip": []
        }
      ],
      "style": "item_group_items",
      "unless": "text_items"
    },
    {
      "type": "system:text",
      "translate": "system.ui.lottery_unavailable",
      "unless": "payment_available"
    },
    {
      "type": "system:text",
      "text": "{{field:price}}: {{price_text}}",
      "when": "text_items"
    },
    {
      "type": "system:text",
      "text": "{{field:price}}: {{price_text}}",
      "when": "confirm",
      "unless": "text_items"
    },
    {
      "type": "system:container",
      "children": [
        {
          "type": "system:text",
          "text": "{{field:price}}",
          "style": "item_group_label"
        },
        {
          "type": "system:flex",
          "source": "{{price_items}}",
          "children": [
            {
              "type": "system:flex",
              "children": [
                {
                  "type": "system:item",
                  "item": "{{price_items.*}}",
                  "size": 40,
                  "tooltip": []
                },
                {
                  "type": "system:text",
                  "text": "{{price_items.*.label}}",
                  "style": "item_name",
                  "unless": "text_items"
                }
              ],
              "wrap": false,
              "style": [
                "item_entry",
                "item_labeled"
              ]
            }
          ],
          "style": "item_group_items"
        }
      ],
      "when": "confirm",
      "unless": "text_items"
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.visible}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
