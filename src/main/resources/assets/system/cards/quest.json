{
  "style": [
    "result_card",
    "quest_detail_card"
  ],
  "body": [
    {
      "type": "system:title",
      "text": "{{title}}"
    },
    {
      "type": "system:button",
      "click": "local",
      "value": "{{pin}}",
      "binding": "{{pin_binding}}",
      "icon": "system:icons/pin.svg",
      "style": "quest_card_pin",
      "unless": "simple",
      "when": "id"
    },
    {
      "type": "system:text",
      "text": "{{field:chapter}}: {{chapter}}"
    },
    {
      "type": "system:text",
      "text": "{{field:progress}}: {{progress}}%"
    },
    {
      "type": "system:text",
      "text": "{{description}}",
      "when": "description"
    },
    {
      "type": "system:container",
      "repeat": "tasks",
      "children": [
        {
          "type": "system:flex",
          "source": "{{tasks.*.task_icons}}",
          "children": [
            {
              "type": "system:ftb_icon",
              "icon": "{{tasks.*.task_icons.*}}"
            }
          ],
          "style": "quest_icon_items"
        },
        {
          "type": "system:flex",
          "source": "{{tasks.*.task_items}}",
          "children": [
            {
              "type": "system:item",
              "item": "{{tasks.*.task_items.*}}",
              "size": 32,
              "tooltip": []
            }
          ],
          "style": "item_group_items"
        },
        {
          "type": "system:text",
          "text": "{{tasks.*.task_title}} · {{tasks.*.task_progress}}/{{tasks.*.task_required}}",
          "unless": "tasks.*.task_icons"
        }
      ]
    },
    {
      "type": "system:container",
      "style": "reward_section",
      "when": "rewards",
      "children": [
        {
          "type": "system:text",
          "style": "item_group_label",
          "text": "{{field:reward}}:"
        },
        {
          "type": "system:container",
          "style": "reward_grid",
          "children": [
            {
              "type": "system:container",
              "repeat": "rewards",
              "children": [
                {
                  "type": "system:container",
                  "when": "text_items",
                  "children": [
                    {
                      "type": "system:text",
                      "text": "{{rewards.*.reward_title}} · {{state:rewards.*.reward_state}}",
                      "unless": "rewards.*.reward_icons"
                    },
                    {
                      "type": "system:flex",
                      "source": "{{rewards.*.reward_icons}}",
                      "children": [
                        {
                          "type": "system:ftb_icon",
                          "icon": "{{rewards.*.reward_icons.*}}"
                        }
                      ],
                      "style": "quest_icon_items"
                    },
                    {
                      "type": "system:text",
                      "text": "{{rewards.*.choices.*.choice_number}}. {{rewards.*.choices.*.choice_title}}",
                      "repeat": "rewards.*.choices",
                      "unless": "rewards.*.choices.*.choice_icons"
                    },
                    {
                      "type": "system:container",
                      "children": [
                        {
                          "type": "system:text",
                          "text": "{{rewards.*.choices.*.choice_number}}",
                          "style": "item_group_label"
                        },
                        {
                          "type": "system:flex",
                          "source": "{{rewards.*.choices.*.choice_icons}}",
                          "children": [
                            {
                              "type": "system:ftb_icon",
                              "icon": "{{rewards.*.choices.*.choice_icons.*}}"
                            }
                          ],
                          "style": "quest_icon_items"
                        }
                      ],
                      "repeat": "rewards.*.choices"
                    }
                  ],
                  "style": "reward_grid"
                },
                {
                  "type": "system:container",
                  "unless": "text_items",
                  "children": [
                    {
                      "type": "system:flex",
                      "source": "{{rewards.*.reward_icons}}",
                      "children": [
                        {
                          "type": "system:ftb_icon",
                          "icon": "{{rewards.*.reward_icons.*}}"
                        }
                      ],
                      "style": "quest_icon_items"
                    },
                    {
                      "type": "system:container",
                      "unless": "rewards.*.reward_icons",
                      "children": [
                        {
                          "type": "system:text",
                          "text": "{{rewards.*.reward_title}} · {{state:rewards.*.reward_state}}",
                          "unless": "rewards.*.result_items"
                        }
                      ]
                    },
                    {
                      "type": "system:flex",
                      "source": "{{rewards.*.result_items}}",
                      "children": [
                        {
                          "type": "system:item",
                          "item": "{{rewards.*.result_items.*}}",
                          "size": 32,
                          "tooltip": [
                            {
                              "type": "system:text",
                              "text": "{{state:rewards.*.reward_state}}"
                            }
                          ]
                        }
                      ],
                      "style": "item_group_items"
                    },
                    {
                      "type": "system:container",
                      "children": [
                        {
                          "type": "system:text",
                          "text": "{{rewards.*.choices.*.choice_number}}. {{rewards.*.choices.*.choice_title}}",
                          "style": "item_group_label"
                        },
                        {
                          "type": "system:flex",
                          "source": "{{rewards.*.choices.*.result_items}}",
                          "children": [
                            {
                              "type": "system:flex",
                              "children": [
                                {
                                  "type": "system:item",
                                  "item": "{{rewards.*.choices.*.result_items.*}}",
                                  "size": 32,
                                  "tooltip": []
                                },
                                {
                                  "type": "system:text",
                                  "text": "{{rewards.*.choices.*.result_items.*.label}}",
                                  "style": "item_name",
                                  "unless": "text_items"
                                }
                              ],
                              "wrap": false,
                              "style": [
                                "item_entry",
                                "item_labeled"
                              ]
                            }
                          ],
                          "style": "item_group_items"
                        }
                      ],
                      "repeat": "rewards.*.choices"
                    },
                    {
                      "type": "system:container",
                      "repeat": "rewards.*.choices",
                      "unless": "rewards.*.choices.*.choice_icons",
                      "children": [
                        {
                          "type": "system:text",
                          "text": "{{rewards.*.choices.*.choice_number}}. {{rewards.*.choices.*.choice_title}}",
                          "unless": "rewards.*.choices.*.result_items"
                        }
                      ]
                    },
                    {
                      "type": "system:container",
                      "children": [
                        {
                          "type": "system:text",
                          "text": "{{rewards.*.choices.*.choice_number}}",
                          "style": "item_group_label"
                        },
                        {
                          "type": "system:flex",
                          "source": "{{rewards.*.choices.*.choice_icons}}",
                          "children": [
                            {
                              "type": "system:ftb_icon",
                              "icon": "{{rewards.*.choices.*.choice_icons.*}}"
                            }
                          ],
                          "style": "quest_icon_items"
                        }
                      ],
                      "repeat": "rewards.*.choices"
                    }
                  ],
                  "style": "reward_grid"
                }
              ],
              "style": "reward_entry"
            }
          ]
        }
      ]
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.visible}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            },
            {
              "type": "system:text",
              "text": " · {{actions.*.action_reward_title}}",
              "when": "actions.*.action_reward_title"
            }
          ]
        }
      ]
    }
  ],
  "actions": {
    "label": [
      {
        "type": "system:text",
        "text": "{{actions.*.label}}"
      },
      {
        "type": "system:text",
        "text": " · {{actions.*.action_reward_title}}",
        "when": "actions.*.action_reward_title"
      }
    ]
  }
}
