{
  "body": [
    {
      "type": "system:text",
      "text": "{{title}}"
    },
    {
      "type": "system:text",
      "text": "{{field:chapter}}: {{chapter}}"
    },
    {
      "type": "system:text",
      "text": "{{field:progress}}: {{progress}}%"
    },
    {
      "type": "system:text",
      "text": "{{field:completed}}: {{bool:completed}}"
    },
    {
      "type": "system:text",
      "text": "{{description}}",
      "when": "description"
    },
    {
      "type": "system:text",
      "text": "{{tasks.*.task_title}} · {{tasks.*.task_progress}}/{{tasks.*.task_required}}",
      "repeat": "tasks"
    },
    {
      "type": "system:container",
      "repeat": "rewards",
      "children": [
        {
          "type": "system:container",
          "when": "text_items",
          "children": [
            {
              "type": "system:text",
              "text": "{{field:reward}}: {{rewards.*.reward_title}} · {{state:rewards.*.reward_state}}"
            },
            {
              "type": "system:text",
              "text": "{{rewards.*.choices.*.choice_number}}. {{rewards.*.choices.*.choice_title}}",
              "repeat": "rewards.*.choices"
            }
          ]
        },
        {
          "type": "system:container",
          "unless": "text_items",
          "children": [
            {
              "type": "system:text",
              "text": "{{field:reward}}: {{rewards.*.reward_title}} · {{state:rewards.*.reward_state}}",
              "unless": "rewards.*.result_items"
            },
            {
              "type": "system:items",
              "items": "{{rewards.*.result_items}}",
              "label": "{{field:reward}}",
              "description": [
                {
                  "type": "system:text",
                  "text": "{{state:rewards.*.reward_state}}"
                }
              ]
            },
            {
              "type": "system:items",
              "items": "{{rewards.*.choices.*.result_items}}",
              "repeat": "rewards.*.choices",
              "label": "{{rewards.*.reward_title}} · {{rewards.*.choices.*.choice_title}}"
            },
            {
              "type": "system:text",
              "text": "{{rewards.*.choices.*.choice_number}}. {{rewards.*.choices.*.choice_title}}",
              "repeat": "rewards.*.choices",
              "unless": "rewards.*.choices.*.result_items"
            }
          ]
        }
      ]
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ],
  "actions": {
    "label": [
      {
        "type": "system:text",
        "text": "{{actions.*.label}}"
      },
      {
        "type": "system:text",
        "text": " · {{actions.*.action_reward_title}}",
        "when": "actions.*.action_reward_title"
      }
    ]
  }
}
