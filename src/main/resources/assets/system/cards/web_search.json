{
  "hide_summary": true,
  "body": [
    {
      "type": "system:title",
      "translate": "system.ui.nav_search"
    },
    {
      "type": "system:markdown",
      "text": "{{answer}}",
      "when": "answer"
    },
    {
      "type": "system:text",
      "text": "{{summary}}",
      "unless": "answer"
    },
    {
      "type": "system:details",
      "summary": "{{tr:system.ui.search_sources}} ({{sources}})",
      "when": "sources",
      "children": [
        {
          "type": "system:column",
          "style": "search_source",
          "repeat": "sources",
          "children": [
            {
              "type": "system:link",
              "text": "[{{sources.*.id}}] {{sources.*.title}}",
              "url": "{{sources.*.url}}"
            },
            {
              "type": "system:context",
              "text": "{{sources.*.snippet}}",
              "when": "sources.*.snippet"
            }
          ]
        }
      ]
    }
  ]
}
