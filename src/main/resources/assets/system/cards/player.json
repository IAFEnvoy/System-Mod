{
  "body": [
    {
      "type": "system:row",
      "style": ["card_row", "player_card_layout"],
      "children": [
        {
          "type": "system:player",
          "style": ["player_preview", "player_preview_bare"],
          "player": "{{player_id}}",
          "follow_mouse": true,
          "yaw": 15,
          "pitch": 0,
          "scale": 1,
          "offset_x": 0,
          "offset_y": 0
        },
        {
          "type": "system:column",
          "style": ["card_column", "player_info"],
          "children": [
            {
              "type": "system:header",
              "translate": "system.ui.player_info"
            },
            {
              "type": "system:player_information",
              "importance": 40
            }
          ]
        }
      ]
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ]
}
