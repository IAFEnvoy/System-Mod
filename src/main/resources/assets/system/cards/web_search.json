{
  "body": [
    { "type": "system:text", "text": "{{summary}}" },
    {
      "type": "system:column",
      "repeat": "sources",
      "children": [
        { "type": "system:context", "text": "[{{sources.*.id}}] {{sources.*.title}}\n{{sources.*.url}}" },
        { "type": "system:text", "text": "{{sources.*.snippet}}", "when": "sources.*.snippet" }
      ]
    }
  ]
}
