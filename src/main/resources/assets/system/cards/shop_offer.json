{
  "body": [
    {
      "type": "system:text",
      "text": "{{label}}"
    },
    {
      "type": "system:text",
      "text": "{{items}}",
      "when": "text_items"
    },
    {
      "type": "system:items",
      "items": "{{offer_items}}",
      "show_labels": false,
      "unless": "text_items",
      "columns": 4,
      "cell": 76,
      "icon": 52,
      "tooltip": [
        {
          "type": "system:text",
          "text": "{{field:price}}: {{price_text}}"
        }
      ]
    },
    {
      "type": "system:text",
      "translate": "system.ui.lottery_unavailable",
      "unless": "payment_available"
    },
    {
      "type": "system:text",
      "text": "{{field:price}}: {{price_text}}",
      "when": "text_items"
    },
    {
      "type": "system:text",
      "text": "{{field:price}}: {{price_text}}",
      "when": "confirm",
      "unless": "text_items"
    },
    {
      "type": "system:items",
      "items": "{{price_items}}",
      "label": "{{field:price}}",
      "when": "confirm",
      "unless": "text_items"
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ]
}
