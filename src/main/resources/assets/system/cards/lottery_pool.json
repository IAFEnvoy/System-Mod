{
  "body": [
    {
      "type": "system:row",
      "style": "lottery_heading",
      "text_separator": " · ",
      "children": [
        {
          "type": "system:title",
          "level": 2,
          "text": "{{label}}",
          "style": "lottery_name"
        },
        {
          "type": "system:text",
          "translate": "system.ui.lottery_count",
          "args": [
            "{{prize_count}}"
          ],
          "inline": true,
          "style": "lottery_count"
        }
      ]
    },
    {
      "type": "system:context",
      "text": "{{id}}",
      "when": "full",
      "style": "lottery_id"
    },
    {
      "type": "system:text",
      "text": "{{field:price}}: {{price_text}}",
      "when": "priced"
    },
    {
      "type": "system:context",
      "translate": "system.ui.lottery_unavailable",
      "unless": "payment_available",
      "style": "lottery_unavailable"
    },
    {
      "type": "system:container",
      "unless": "text_items",
      "when": "prizes",
      "children": [
        {
          "type": "system:context",
          "translate": "system.ui.lottery_prize_preview",
          "args": [
            "{{preview_count}}",
            "{{prize_count}}"
          ],
          "style": "item_group_label"
        },
        {
          "type": "system:prize_grid",
          "prizes": "{{prize_list}}",
          "columns": 6,
          "max_row": 3,
          "cell": 104
        },
        {
          "type": "system:context",
          "translate": "system.ui.lottery_hint",
          "style": "lottery_hint"
        }
      ]
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ],
  "style": [
    "result_card",
    "lottery_card"
  ],
  "show_title": false,
  "hide_summary": true
}
