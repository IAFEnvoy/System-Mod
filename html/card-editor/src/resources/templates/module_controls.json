{
  "style": [
    "result_card",
    "workspace_controls"
  ],
  "show_title": false,
  "hide_summary": true,
  "body": [
    {
      "type": "system:flex",
      "style": "workspace_controls_layout",
      "children": [
        {
          "type": "system:title",
          "level": 2,
          "text": "{{title}}",
          "style": "workspace_controls_title"
        },
        {
          "type": "system:button",
          "click": "local",
          "value": "submit",
          "text": "{{action_label}}",
          "style": "workspace_controls_action"
        }
      ]
    },
    {
      "type": "system:text",
      "text": "{{description}}",
      "style": "workspace_controls_note"
    }
  ]
}
