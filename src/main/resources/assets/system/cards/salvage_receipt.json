{
  "body": [
    {
      "type": "system:text",
      "text": "{{tr:system.salvage.space_note}}"
    },
    {
      "type": "system:flex",
      "source": "{{contents}}",
      "style": "item_group_items",
      "children": [
        {
          "type": "system:flex",
          "wrap": false,
          "style": [
            "item_entry",
            "item_labeled"
          ],
          "children": [
            {
              "type": "system:icon",
              "icon": "{{contents.*.icon}}",
              "tooltip": [
                {
                  "type": "system:text",
                  "text": "{{contents.*.label}}"
                }
              ]
            },
            {
              "type": "system:text",
              "text": "{{contents.*.label}}",
              "style": "item_name"
            }
          ]
        }
      ]
    },
    {
      "type": "system:text",
      "text": "{{tr:system.field.order_id}}: {{order_id}}",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{state}}",
      "style": "card_context"
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.visible}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
