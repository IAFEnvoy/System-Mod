{
  "body": [
    {
      "type": "system:title",
      "translate": "system.ui.nav_online_jobs"
    },
    {
      "type": "system:text",
      "translate": "system.jobs.note",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{queue_summary}}",
      "style": "card_context"
    },
    {
      "type": "system:container",
      "when": "quote",
      "children": [
        {
          "type": "system:text",
          "text": "{{quote_label}}",
          "style": "card_title_2"
        },
        {
          "type": "system:text",
          "translate": "system.jobs.cost_note",
          "style": "card_context"
        },
        {
          "type": "system:text",
          "text": "{{quote_cost}}",
          "style": "card_context"
        }
      ]
    },
    {
      "type": "system:grid",
      "source": "{{runs}}",
      "columns": 2,
      "compact_columns": 1,
      "max_row": 3,
      "cell": 188,
      "children": [
        {
          "type": "system:text",
          "text": "{{runs.*.label}}",
          "style": "offer_cell_label"
        },
        {
          "type": "system:text",
          "text": "{{runs.*.status}}",
          "style": "card_context"
        },
        {
          "type": "system:text",
          "text": "{{runs.*.time}}",
          "when": "runs.*.progress_visible",
          "style": "card_context"
        },
        {
          "type": "system:flex",
          "style": "offer_cell_items",
          "wrap": false,
          "children": [
            {
              "type": "system:flex",
              "source": "{{runs.*.items}}",
              "style": "item_group_items",
              "children": [
                {
                  "type": "system:item",
                  "item": "{{runs.*.items.*}}",
                  "size": 28,
                  "tooltip": [
                    {
                      "type": "system:text",
                      "text": "{{runs.*.label}}"
                    },
                    {
                      "type": "system:text",
                      "text": "{{runs.*.reward}}"
                    },
                    {
                      "type": "system:text",
                      "text": "{{runs.*.cost}}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "system:flex",
              "source": "{{runs.*.preview_contents}}",
              "style": "item_group_items",
              "unless": "text_items",
              "children": [
                {
                  "type": "system:icon",
                  "icon": "{{runs.*.preview_contents.*.icon}}",
                  "tooltip": [
                    {
                      "type": "system:text",
                      "text": "{{runs.*.label}}"
                    },
                    {
                      "type": "system:text",
                      "text": "{{runs.*.reward}}"
                    },
                    {
                      "type": "system:text",
                      "text": "{{runs.*.cost}}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "system:text",
          "text": "{{runs.*.reward}}",
          "when": "text_items",
          "style": "card_context"
        },
        {
          "type": "system:progress",
          "value": "{{runs.*.progress}}",
          "when": "runs.*.progress_visible"
        },
        {
          "type": "system:flex",
          "style": "card_actions",
          "children": [
            {
              "type": "system:button",
              "click": "return-val",
              "value": "{{runs.*.claim_value}}",
              "behavior": "replace",
              "when": "runs.*.can_claim",
              "children": [
                {
                  "type": "system:text",
                  "translate": "system.action.job_claim"
                }
              ]
            },
            {
              "type": "system:button",
              "click": "return-val",
              "value": "{{runs.*.cancel_value}}",
              "behavior": "replace",
              "when": "runs.*.can_cancel",
              "children": [
                {
                  "type": "system:text",
                  "translate": "system.action.job_cancel"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "system:text",
      "translate": "system.jobs.available",
      "style": "card_title_2"
    },
    {
      "type": "system:text",
      "translate": "system.jobs.empty",
      "unless": "jobs",
      "style": "card_context"
    },
    {
      "type": "system:grid",
      "source": "{{jobs}}",
      "columns": 3,
      "compact_columns": 2,
      "max_row": 3,
      "cell": 180,
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "label": "{{jobs.*.label}}",
          "style": "offer_cell_content",
          "children": [
            {
              "type": "system:flex",
              "style": "offer_cell_items",
              "children": [
                {
                  "type": "system:flex",
                  "source": "{{jobs.*.items}}",
                  "children": [
                    {
                      "type": "system:item",
                      "item": "{{jobs.*.items.*}}",
                      "size": 32
                    }
                  ]
                },
                {
                  "type": "system:flex",
                  "source": "{{jobs.*.preview_contents}}",
                  "children": [
                    {
                      "type": "system:flex",
                      "wrap": false,
                      "style": [
                        "item_entry",
                        "item_labeled"
                      ],
                      "children": [
                        {
                          "type": "system:icon",
                          "icon": "{{jobs.*.preview_contents.*.icon}}",
                          "unless": "text_items",
                          "tooltip": [
                            {
                              "type": "system:text",
                              "text": "{{jobs.*.preview_contents.*.label}}"
                            },
                            {
                              "type": "system:text",
                              "text": "{{jobs.*.reward_text}}"
                            }
                          ],
                          "style": "item_entry"
                        }
                      ]
                    }
                  ],
                  "style": "item_group_items"
                }
              ]
            },
            {
              "type": "system:text",
              "text": "{{jobs.*.label}}",
              "style": "offer_cell_label"
            },
            {
              "type": "system:text",
              "text": "{{jobs.*.duration}}",
              "style": "card_context"
            },
            {
              "type": "system:text",
              "text": "{{jobs.*.description}}",
              "style": "card_context"
            },
            {
              "type": "system:text",
              "text": "{{jobs.*.cost}}",
              "style": "card_context"
            },
            {
              "type": "system:text",
              "text": "{{jobs.*.reward_text}}",
              "when": "text_items"
            },
            {
              "type": "system:text",
              "translate": "system.ui.condition_unmet",
              "when": "jobs.*.condition_unmet",
              "style": "card_context"
            }
          ]
        }
      ]
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.footer}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "when": "actions.*.visible",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
