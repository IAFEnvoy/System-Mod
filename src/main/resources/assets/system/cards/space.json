{
  "body": [
    {
      "type": "system:title",
      "translate": "system.ui.nav_inbox"
    },
    {
      "type": "system:text",
      "translate": "system.ui.space_hint",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{feedback}}",
      "when": "feedback"
    },
    {
      "type": "system:text",
      "translate": "system.ui.space_empty",
      "unless": "entries"
    },
    {
      "type": "system:grid",
      "source": "{{entries}}",
      "columns": 6,
      "max_row": 3,
      "cell": 104,
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "shift_value": "{{actions.*.shift_value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "replace",
          "style": "offer_cell_content",
          "children": [
            {
              "type": "system:icon",
              "icon": "{{entries.*.icon}}",
              "style": "offer_cell_items"
            },
            {
              "type": "system:text",
              "text": "{{entries.*.name}}",
              "style": "offer_cell_label"
            },
            {
              "type": "system:text",
              "text": "× {{entries.*.amount}}",
              "style": "card_action_cell_meta"
            },
            {
              "type": "system:text",
              "translate": "system.ui.space_blocked",
              "when": "entries.*.blocked",
              "style": "card_action_cell_meta"
            },
            {
              "type": "system:text",
              "translate": "system.choice.awaiting",
              "when": "entries.*.choice",
              "style": "card_action_cell_meta"
            }
          ]
        }
      ]
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.footer}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "when": "actions.*.visible",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
