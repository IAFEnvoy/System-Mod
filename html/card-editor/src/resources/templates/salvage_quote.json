{
  "body": [
    {
      "type": "system:flex",
      "direction": "row",
      "wrap": false,
      "style": [
        "item_entry",
        "item_labeled"
      ],
      "children": [
        {
          "type": "system:item",
          "item": "{{item}}",
          "size": 40
        },
        {
          "type": "system:text",
          "text": "{{item_name}}",
          "style": "card_title"
        }
      ]
    },
    {
      "type": "system:text",
      "text": "{{tr:system.salvage.rule}} {{rule}}",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{tr:system.salvage.outputs}}",
      "style": "item_group_label"
    },
    {
      "type": "system:flex",
      "source": "{{contents}}",
      "style": "item_group_items",
      "children": [
        {
          "type": "system:flex",
          "wrap": false,
          "style": [
            "item_entry",
            "item_labeled"
          ],
          "children": [
            {
              "type": "system:icon",
              "icon": "{{contents.*.icon}}",
              "tooltip": [
                {
                  "type": "system:text",
                  "text": "{{contents.*.label}}"
                }
              ]
            },
            {
              "type": "system:text",
              "text": "{{contents.*.label}}",
              "style": "item_name"
            }
          ]
        }
      ]
    },
    {
      "type": "system:text",
      "text": "{{tr:system.workshop.price}} {{price}}"
    },
    {
      "type": "system:text",
      "text": "{{tr:system.salvage.confirm_note}}",
      "style": "card_context"
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.visible}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
