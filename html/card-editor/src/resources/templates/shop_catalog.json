{
  "body": [
    {
      "type": "system:title",
      "text": "{{catalog_title}}"
    },
    {
      "type": "system:flex",
      "direction": "column",
      "source": "{{rotations}}",
      "style": "card_column",
      "children": [
        {
          "type": "system:text",
          "text": "{{rotations.*.description}}",
          "style": "card_context"
        }
      ]
    },
    {
      "type": "system:text",
      "translate": "system.ui.shop_search_required",
      "when": "search_required",
      "style": "card_context"
    },
    {
      "type": "system:grid",
      "source": "{{offers}}",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:flex",
              "style": "offer_cell_items",
              "children": [
                {
                  "type": "system:flex",
                  "source": "{{offers.*.items}}",
                  "children": [
                    {
                      "type": "system:item",
                      "item": "{{offers.*.items.*}}",
                      "size": 36,
                      "tooltip": [
                        {
                          "type": "system:text",
                          "text": "{{offers.*.tooltip}}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "system:flex",
                  "source": "{{offers.*.contents}}",
                  "children": [
                    {
                      "type": "system:flex",
                      "wrap": false,
                      "style": [
                        "item_entry",
                        "item_labeled"
                      ],
                      "children": [
                        {
                          "type": "system:icon",
                          "icon": "{{offers.*.contents.*.icon}}",
                          "unless": "text_items",
                          "tooltip": [
                            {
                              "type": "system:text",
                              "text": "{{offers.*.contents.*.label}}"
                            },
                            {
                              "type": "system:text",
                              "text": "{{offers.*.tooltip}}"
                            }
                          ],
                          "style": "item_entry"
                        }
                      ]
                    }
                  ],
                  "style": "item_group_items"
                }
              ]
            },
            {
              "type": "system:text",
              "text": "{{offers.*.label}}",
              "style": "offer_cell_label"
            },
            {
              "type": "system:text",
              "translate": "system.ui.condition_unmet",
              "when": "offers.*.condition_unmet",
              "style": "card_context"
            }
          ],
          "style": "offer_cell_content"
        }
      ],
      "columns": 6,
      "max_row": 3,
      "cell": 104
    },
    {
      "type": "system:text",
      "translate": "system.ui.shop_truncated",
      "when": "truncated"
    },
    {
      "type": "system:text",
      "translate": "system.ui.shop_no_matches",
      "when": "no_matches"
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.footer}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "when": "actions.*.visible",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
