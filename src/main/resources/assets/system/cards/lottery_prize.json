{
  "body": [
    {
      "type": "system:row",
      "style": "lottery_heading",
      "text_separator": " · ",
      "children": [
        {
          "type": "system:header",
          "text": "{{reward_label}}",
          "style": "lottery_name"
        },
        {
          "type": "system:text",
          "translate": "system.ui.lottery_chance",
          "args": [
            "{{chance}}%"
          ],
          "inline": true,
          "style": "lottery_chance"
        }
      ]
    },
    {
      "type": "system:text",
      "text": "{{reward_items}}",
      "when": "text_items"
    },
    {
      "type": "system:items",
      "items": "{{result_items}}",
      "label": "{{field:reward}}"
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ],
  "style": [
    "result_card",
    "lottery_card",
    "lottery_prize"
  ],
  "show_title": false
}
