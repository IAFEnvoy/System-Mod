{
  "body": [
    {
      "type": "system:title",
      "text": "{{reward_label}}"
    },
    {
      "type": "system:text",
      "text": "{{summary}}",
      "when": "summary"
    },
    {
      "type": "system:text",
      "text": "{{reason}}",
      "when": "reason"
    },
    {
      "type": "system:text",
      "text": "{{reward_items}}",
      "when": "text_items"
    },
    {
      "type": "system:items",
      "items": "{{result_items}}",
      "label": "{{field:reward}}"
    },
    {
      "type": "system:button",
      "text": "{{tr:system.state.claimed}}",
      "callback": "delivered",
      "when": "delivered"
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ]
}
