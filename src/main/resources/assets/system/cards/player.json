{
  "body": [
    {
      "type": "system:text",
      "text": "{{field:name}}: {{name}}"
    },
    {
      "type": "system:text",
      "text": "{{field:health}}: {{health}}"
    },
    {
      "type": "system:text",
      "text": "{{field:max_health}}: {{max_health}}"
    },
    {
      "type": "system:text",
      "text": "{{field:experience_level}}: {{experience_level}}"
    },
    {
      "type": "system:text",
      "text": "{{field:dimension}}: {{dimension}}"
    },
    {
      "type": "system:text",
      "text": "{{field:online_players}}:",
      "when": "online_players"
    },
    {
      "type": "system:text",
      "text": "{{online_players.*.player_name}}",
      "repeat": "online_players"
    },
    {
      "type": "system:text",
      "text": "{{field:language}}: {{language}}"
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ]
}
