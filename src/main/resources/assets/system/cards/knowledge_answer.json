{
  "body": [
    {"type": "system:text", "text": "{{summary}}"},
    {
      "type": "system:details",
      "summary": "{{tr:system.ui.knowledge_sources}} ({{sources}})",
      "when": "sources",
      "children": [
        {
          "type": "system:column",
          "style": "guide_entry",
          "repeat": "sources",
          "children": [
            {"type": "system:header", "text": "{{sources.*.title}}"},
            {"type": "system:context", "text": "{{sources.*.category}}", "when": "sources.*.category"},
            {"type": "system:text", "text": "{{sources.*.passage}}"}
          ]
        }
      ]
    }
  ]
}
