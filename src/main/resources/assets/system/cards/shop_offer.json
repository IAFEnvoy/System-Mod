{
  "body": [
    {
      "type": "system:title",
      "text": "{{label}}"
    },
    {
      "type": "system:text",
      "text": "{{activity}}",
      "when": "activity",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{quantity}}",
      "when": "confirm",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{summary}}",
      "when": "confirm"
    },
    {
      "type": "system:text",
      "text": "{{reward_heading}}",
      "when": "buyback",
      "style": "item_group_label"
    },
    {
      "type": "system:text",
      "text": "{{items}}",
      "when": "text_items"
    },
    {
      "type": "system:flex",
      "source": "{{offer_items}}",
      "children": [
        {
          "type": "system:item",
          "item": "{{offer_items.*}}",
          "size": 40,
          "tooltip": []
        }
      ],
      "style": "item_group_items",
      "unless": "text_items"
    },
    {
      "type": "system:flex",
      "source": "{{contents}}",
      "children": [
        {
          "type": "system:flex",
          "wrap": false,
          "style": [
            "item_entry",
            "item_labeled"
          ],
          "children": [
            {
              "type": "system:icon",
              "icon": "{{contents.*.icon}}",
              "unless": "text_items",
              "style": "item_entry",
              "tooltip": [
                {
                  "type": "system:text",
                  "text": "{{contents.*.label}}"
                }
              ]
            },
            {
              "type": "system:text",
              "text": "{{contents.*.label}}",
              "style": "item_name"
            }
          ]
        }
      ],
      "style": "item_group_items"
    },
    {
      "type": "system:text",
      "translate": "system.ui.condition_unmet",
      "when": "condition_unmet",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{payment_unavailable_text}}",
      "when": "payment_unavailable"
    },
    {
      "type": "system:text",
      "text": "{{purchase_limit}}",
      "when": "has_purchase_limit"
    },
    {
      "type": "system:text",
      "text": "{{cost_heading}}: {{price_text}}",
      "when": "text_items"
    },
    {
      "type": "system:container",
      "children": [
        {
          "type": "system:text",
          "text": "{{cost_heading}}",
          "style": "item_group_label"
        },
        {
          "type": "system:text",
          "text": "{{price}}",
          "when": "has_price_description"
        },
        {
          "type": "system:flex",
          "source": "{{price_items}}",
          "children": [
            {
              "type": "system:flex",
              "children": [
                {
                  "type": "system:item",
                  "item": "{{price_items.*}}",
                  "size": 40,
                  "tooltip": []
                },
                {
                  "type": "system:text",
                  "text": "{{price_items.*.label}}",
                  "style": "item_name",
                  "unless": "text_items"
                }
              ],
              "wrap": false,
              "style": [
                "item_entry",
                "item_labeled"
              ]
            }
          ],
          "style": "item_group_items"
        }
      ],
      "when": "show_price",
      "unless": "text_items"
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.visible}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
