{
  "body": [
    {
      "type": "system:title",
      "text": "{{title}}"
    },
    {
      "type": "system:text",
      "text": "{{summary}}",
      "when": "summary"
    },
    {
      "type": "system:container",
      "repeat": "tasks",
      "children": [
        {
          "type": "system:icons",
          "icons": "{{tasks.*.task_icons}}"
        },
        {
          "type": "system:items",
          "items": "{{tasks.*.task_items}}",
          "compact": true,
          "show_labels": false
        },
        {
          "type": "system:text",
          "text": "{{tasks.*.task_title}} · {{tasks.*.task_progress}}/{{tasks.*.task_required}}",
          "unless": "tasks.*.task_icons"
        }
      ]
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ]
}
