{
  "chapter.5A71040000000000.title": "04 · 物资上交",
  "quest.5A71040001000000.title": "上交 8 块圆石",
  "quest.5A71040001000000.quest_desc": [
    "需要主动提交，提交会消耗圆石。"
  ],
  "quest.5A71040002000000.title": "上交 4 颗苹果",
  "quest.5A71040003000000.title": "混合清单：检测、消耗与勾选",
  "quest.5A71040003000000.quest_desc": [
    "火把只检测，原木需要提交消耗，最后还要勾选确认。只要含一个提交目标，整个任务就属于手动提交任务。"
  ],
  "quest.5A71040004000000.title": "按顺序准备补给",
  "quest.5A71040004000000.quest_desc": [
    "先提交圆石，再勾选确认，用于检查连续提交行为。"
  ],
  "quest.5A71040005000000.title": "仅在 FTB 原生界面上交",
  "quest.5A71040005000000.quest_desc": [
    "这个目标要求在 FTB 原生任务界面提交，系统不能替它执行。"
  ]
}
