{
  "hide_summary": true,
  "body": [
    {
      "type": "system:title",
      "translate": "system.lottery.history"
    },
    {
      "type": "system:text",
      "text": "{{range}}",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "translate": "system.lottery.history_empty",
      "unless": "orders"
    },
    {
      "type": "system:grid",
      "source": "{{orders}}",
      "unless": "detail",
      "columns": 1,
      "compact_columns": 1,
      "max_row": 3,
      "cell": 144,
      "children": [
        {
          "type": "system:text",
          "text": "{{orders.*.label}}",
          "style": "offer_cell_label"
        },
        {
          "type": "system:text",
          "text": "{{orders.*.count}} · {{orders.*.state}}",
          "style": "card_context"
        },
        {
          "type": "system:text",
          "text": "{{orders.*.time}}",
          "style": "card_context"
        },
        {
          "type": "system:button",
          "when": "actions.*.visible",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "translate": "system.lottery.view_record"
            }
          ]
        }
      ]
    },
    {
      "type": "system:container",
      "when": "detail",
      "repeat": "orders",
      "children": [
        {
          "type": "system:text",
          "text": "{{orders.*.heading}}",
          "style": "item_group_label"
        },
        {
          "type": "system:text",
          "text": "{{orders.*.time}}",
          "style": "card_context"
        },
        {
          "type": "system:text",
          "text": "{{orders.*.id}}",
          "style": "card_context"
        },
        {
          "type": "system:text",
          "translate": "system.lottery.result_locked",
          "unless": "orders.*.rolls"
        },
        {
          "type": "system:grid",
          "source": "{{orders.*.rolls}}",
          "columns": 1,
          "compact_columns": 1,
          "max_row": 3,
          "cell": 128,
          "children": [
            {
              "type": "system:text",
              "text": "{{orders.*.rolls.*.label}}",
              "style": "offer_cell_label"
            },
            {
              "type": "system:text",
              "translate": "system.lottery.guaranteed",
              "when": "orders.*.rolls.*.guaranteed",
              "style": "card_context"
            },
            {
              "type": "system:text",
              "text": "{{orders.*.rolls.*.contents}}"
            }
          ]
        }
      ]
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.pager}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "when": "actions.*.visible",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
