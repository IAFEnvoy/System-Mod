{
  "body": [
    {
      "type": "system:title",
      "translate": "system.ui.nav_signin"
    },
    {
      "type": "system:text",
      "text": "{{field:date}}: {{date}}"
    },
    {
      "type": "system:text",
      "text": "{{counts}}",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{activities.*}}",
      "repeat": "activities",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{period_counts}}",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "translate": "system.signin.fixed",
      "when": "fixed",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{field:signed_in}}: {{bool:signed_in}}"
    },
    {
      "type": "system:text",
      "text": "{{field:history_saved}}: {{bool:history_saved}}"
    },
    {
      "type": "system:text",
      "text": "{{field:external_model}}: {{bool:external_model}}"
    },
    {
      "type": "system:text",
      "translate": "system.signin.offline",
      "when": "offline_signin",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{progression_summary}}",
      "when": "offline_signin",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "text": "{{progression_range}}",
      "when": "progression_range",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "translate": "system.signin.bootstrap",
      "when": "progression_bootstrap",
      "style": "card_context"
    },
    {
      "type": "system:text",
      "translate": "system.error.sign_in_no_reward",
      "when": "no_offline_rewards",
      "style": "card_context"
    },
    {
      "type": "system:container",
      "when": "text_items",
      "repeat": "candidates",
      "children": [
        {
          "type": "system:text",
          "text": "{{candidates.*.reward_label}}"
        },
        {
          "type": "system:text",
          "translate": "system.ui.condition_unmet",
          "when": "candidates.*.condition_unmet",
          "style": "card_context"
        },
        {
          "type": "system:text",
          "text": "{{candidates.*.reward_items}}",
          "when": "text_items"
        },
        {
          "type": "system:flex",
          "source": "{{candidates.*.contents}}",
          "children": [
            {
              "type": "system:flex",
              "wrap": false,
              "style": [
                "item_entry",
                "item_labeled"
              ],
              "children": [
                {
                  "type": "system:icon",
                  "icon": "{{candidates.*.contents.*.icon}}",
                  "unless": "text_items",
                  "style": "item_entry",
                  "tooltip": [
                    {
                      "type": "system:text",
                      "text": "{{candidates.*.contents.*.label}}"
                    }
                  ]
                },
                {
                  "type": "system:text",
                  "text": "{{candidates.*.contents.*.label}}",
                  "style": "item_name"
                }
              ]
            }
          ],
          "style": "item_group_items"
        }
      ]
    },
    {
      "type": "system:container",
      "when": "candidates",
      "unless": "text_items",
      "children": [
        {
          "type": "system:text",
          "text": "{{field:candidates}}:",
          "style": [
            "item_group_label",
            "card_context"
          ]
        },
        {
          "type": "system:flex",
          "source": "{{candidates.*.result_items}}",
          "children": [
            {
              "type": "system:flex",
              "children": [
                {
                  "type": "system:item",
                  "item": "{{candidates.*.result_items.*}}",
                  "size": 40,
                  "tooltip": [
                    {
                      "type": "system:text",
                      "text": "{{candidates.*.reward_label}}"
                    }
                  ]
                },
                {
                  "type": "system:text",
                  "text": "{{candidates.*.result_items.*.label}}",
                  "style": "item_name",
                  "unless": "text_items"
                }
              ],
              "wrap": false,
              "style": [
                "item_entry",
                "item_labeled"
              ]
            }
          ],
          "style": "item_group_items",
          "repeat": "candidates"
        },
        {
          "type": "system:flex",
          "source": "{{candidates.*.contents}}",
          "children": [
            {
              "type": "system:flex",
              "wrap": false,
              "style": [
                "item_entry",
                "item_labeled"
              ],
              "children": [
                {
                  "type": "system:icon",
                  "icon": "{{candidates.*.contents.*.icon}}",
                  "unless": "text_items",
                  "tooltip": [
                    {
                      "type": "system:text",
                      "text": "{{candidates.*.contents.*.label}}"
                    },
                    {
                      "type": "system:text",
                      "text": "{{candidates.*.reward_label}}"
                    }
                  ],
                  "style": "item_entry"
                },
                {
                  "type": "system:text",
                  "text": "{{candidates.*.contents.*.label}}",
                  "style": "item_name"
                }
              ]
            }
          ],
          "style": "item_group_items",
          "repeat": "candidates"
        },
        {
          "type": "system:text",
          "repeat": "candidates",
          "when": "candidates.*.condition_unmet",
          "text": "{{candidates.*.reward_label}} · {{tr:system.ui.condition_unmet}}",
          "style": "card_context"
        }
      ]
    },
    {
      "type": "system:flex",
      "direction": "column",
      "style": "card_column",
      "source": "{{milestones}}",
      "children": [
        {
          "type": "system:text",
          "text": "{{milestones.*}}",
          "style": "card_context"
        }
      ]
    },
    {
      "type": "system:flex",
      "source": "{{actions}}",
      "filter": "{{actions.*.visible}}",
      "style": "card_actions",
      "children": [
        {
          "type": "system:button",
          "click": "{{actions.*.click_type}}",
          "value": "{{actions.*.value}}",
          "disabled": "{{actions.*.disabled}}",
          "behavior": "{{actions.*.behavior}}",
          "children": [
            {
              "type": "system:text",
              "text": "{{actions.*.number}}. ",
              "inline": true,
              "when": "show_action_numbers"
            },
            {
              "type": "system:text",
              "text": "{{actions.*.label}}"
            }
          ]
        }
      ]
    }
  ]
}
