{
  "body": [
    {
      "type": "system:text",
      "text": "{{description}}",
      "when": "description"
    },
    {
      "type": "system:text",
      "translate": "system.tts.quest.requirements",
      "args": [
        "{{requirements}}"
      ],
      "when": "requirements"
    },
    {
      "type": "system:text",
      "translate": "system.ui.quest_manual_submission",
      "when": "manual_submission"
    },
    {
      "type": "system:text",
      "translate": "system.tts.quest.rewards",
      "args": [
        "{{other_rewards}}"
      ],
      "when": "other_rewards"
    },
    {
      "type": "system:items",
      "items": "{{result_items}}",
      "label": "{{field:reward}}"
    },
    {
      "type": "system:actions",
      "actions": "{{result_actions}}"
    }
  ]
}
